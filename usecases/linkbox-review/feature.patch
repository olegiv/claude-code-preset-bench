+package preview
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func page(body string, status int) *httptest.Server {
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(status)
+		_, _ = w.Write([]byte(body))
+	}))
+}
+
+func TestTitle(t *testing.T) {
+	srv := page("<html><head><title>\n  Hello &amp;  welcome </title></head></html>", http.StatusOK)
+	defer srv.Close()
+	got, err := NewFetcher().Title(context.Background(), srv.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != "Hello & welcome" {
+		t.Errorf("Title = %q", got)
+	}
+}
+
+func TestTitleMissing(t *testing.T) {
+	srv := page("<html><body>no title</body></html>", http.StatusOK)
+	defer srv.Close()
+	if _, err := NewFetcher().Title(context.Background(), srv.URL); !errors.Is(err, ErrNoTitle) {
+		t.Errorf("err = %v, want ErrNoTitle", err)
+	}
+}
+
+func TestTitleBadStatus(t *testing.T) {
+	srv := page("gone", http.StatusNotFound)
+	defer srv.Close()
+	if _, err := NewFetcher().Title(context.Background(), srv.URL); err == nil {
+		t.Error("a 404 page gave a title")
+	}
+}
+
+func TestTitleCached(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		_, _ = w.Write([]byte("<title>Once</title>"))
+	}))
+	defer srv.Close()
+	f := NewFetcher()
+	for range 3 {
+		if _, err := f.Title(context.Background(), srv.URL); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if n := calls.Load(); n != 1 {
+		t.Errorf("the page was fetched %d times", n)
+	}
+}
+
+func TestTitleTimeout(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(50 * time.Millisecond)
+		_, _ = w.Write([]byte("<title>Slow</title>"))
+	}))
+	defer srv.Close()
+	f := NewFetcher()
+	if _, err := f.Title(context.Background(), srv.URL); err != nil {
+		t.Fatalf("a slow page failed: %v", err)
+	}
+}
