+++ b/internal/preview/preview.go
@@ -0,0 +1,102 @@
+// Package preview fetches the titles of web pages.
+package preview
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"html"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+// maxPageBytes is how much of a page Fetch reads while looking for its <title>.
+const maxPageBytes = 1 << 20
+
+// ErrNoTitle reports a page without a <title> element.
+var ErrNoTitle = errors.New("page has no title")
+
+var titleRE = regexp.MustCompile(`(?is)<title[^>]*>(.*?)</title>`)
+
+type entry struct {
+	title   string
+	fetched time.Time
+}
+
+// Fetcher fetches page titles and caches them.
+type Fetcher struct {
+	client *http.Client
+	ttl    time.Duration
+	cache  map[string]entry
+	now    func() time.Time
+}
+
+// NewFetcher returns a fetcher that gives each page 5 seconds and keeps a title for a day.
+func NewFetcher() *Fetcher {
+	return &Fetcher{
+		client: &http.Client{Timeout: 5 * time.Second},
+		ttl:    24 * time.Minute,
+		cache:  map[string]entry{},
+		now:    time.Now,
+	}
+}
+
+// Title returns the <title> of the page at url, from the cache while it is fresh.
+func (f *Fetcher) Title(ctx context.Context, url string) (string, error) {
+	if e, ok := f.cache[url]; ok && f.now().Sub(e.fetched) < f.ttl {
+		return e.title, nil
+	}
+	title, err := f.fetch(ctx, url)
+	if err != nil {
+		return "", err
+	}
+	f.cache[url] = entry{title: title, fetched: f.now()}
+	return title, nil
+}
+
+func (f *Fetcher) fetch(ctx context.Context, url string) (string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("User-Agent", "linkbox-preview/1.0")
+	resp, err := f.client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("fetching %s: %s", url, resp.Status)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxPageBytes))
+	_ = resp.Body.Close() // nothing is left to read; a close error cannot lose data
+	if err != nil {
+		return "", err
+	}
+	m := titleRE.FindSubmatch(body)
+	if m == nil {
+		return "", ErrNoTitle
+	}
+	title := strings.Join(strings.Fields(html.UnescapeString(string(m[1]))), " ")
+	if title == "" {
+		return "", ErrNoTitle
+	}
+	return title, nil
+}
+
+// TitleAll fetches the titles of urls concurrently. titles[i] and errs[i] belong to urls[i].
+func (f *Fetcher) TitleAll(ctx context.Context, urls []string) (titles []string, errs []error) {
+	titles = make([]string, len(urls))
+	errs = make([]error, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Go(func() {
+			titles[i], errs[i] = f.Title(ctx, u)
+		})
+	}
+	wg.Wait()
+	return titles, errs
+}
