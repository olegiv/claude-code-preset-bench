+
+	"linkbox/internal/store"
+)
+
+func TestWriteCSV(t *testing.T) {
+	dir := t.TempDir()
+	created := time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)
+	links := []*store.Link{
+		{ID: "l2", URL: "https://example.com/b", Title: "B, with a comma", Tags: []string{"go", "web"}, CreatedAt: created},
+		{ID: "l1", URL: "https://example.com/a", CreatedAt: created, PreviewTitle: "A page"},
+	}
+	path, err := WriteCSV(dir, "mine.csv", links)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 3 {
+		t.Fatalf("%d rows, want a header and 2 links", len(rows))
+	}
+	if rows[1][2] != "B, with a comma" || rows[1][3] != "go web" || rows[2][5] != "A page" {
+		t.Errorf("rows = %q", rows)
+	}
+}
+
+func TestWriteCSVEscapesFormulas(t *testing.T) {
+	links := []*store.Link{{ID: "l1", URL: "https://example.com/", Title: "=1+1", Tags: []string{"-x"}, PreviewTitle: "@sum"}}
+	path, err := WriteCSV(t.TempDir(), "mine.csv", links)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 2 || rows[1][1] != "https://example.com/" || rows[1][2] != "'=1+1" || rows[1][3] != "'-x" || rows[1][5] != "'@sum" {
+		t.Errorf("rows = %q", rows)
+	}
+}
+
+func TestWriteCSVRejectsName(t *testing.T) {
+	if _, err := WriteCSV(t.TempDir(), "mine.txt", nil); !errors.Is(err, ErrBadName) {
+		t.Errorf("err = %v, want ErrBadName", err)
+	}
+}
+
+func TestCleanup(t *testing.T) {
+	dir := t.TempDir()
+	now := time.Now()
+	old := now.Add(-48 * time.Hour)
+	for name, mtime := range map[string]time.Time{"export-old.csv": old, "export-new.csv": now, "notes.txt": old} {
+		p := filepath.Join(dir, name)
+		if err := os.WriteFile(p, []byte("x"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Chtimes(p, mtime, mtime); err != nil {
+			t.Fatal(err)
+		}
+	}
+	n, err := Cleanup(dir, 24*time.Hour, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 1 {
+		t.Errorf("removed %d files, want 1", n)
+	}
+	for name, want := range map[string]bool{"export-old.csv": false, "export-new.csv": true, "notes.txt": true} {
+		if _, err := os.Stat(filepath.Join(dir, name)); (err == nil) != want {
+			t.Errorf("%s: exists = %v, want %v", name, err == nil, want)
+		}
+	}
+}
