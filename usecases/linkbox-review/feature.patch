+// previewLink fetches the title of the page a link points to and stores it with the link.
+func (s *Server) previewLink(w http.ResponseWriter, r *http.Request, user string) {
+	id := r.PathValue("id")
+	l, err := s.store.Get(user, id)
+	if errors.Is(err, store.ErrNotFound) {
+		writeError(w, http.StatusNotFound, "link not found")
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), previewTimeout)
+	defer cancel()
+	title, err := s.previews.Title(ctx, l.URL)
+	if err != nil {
+		writeError(w, http.StatusBadGateway, "could not fetch the page: "+err.Error())
+		return
+	}
+	_ = s.store.UpdatePreview(user, id, title, time.Now())
+	writeJSON(w, http.StatusOK, map[string]string{"id": id, "preview_title": title})
+}
+
+// previewAll refreshes the previews of all the caller's links and reports how many it updated.
+func (s *Server) previewAll(w http.ResponseWriter, r *http.Request, user string) {
+	links := s.store.List(user, "")
+	urls := make([]string, len(links))
+	for i, l := range links {
+		urls[i] = l.URL
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), previewTimeout)
+	defer cancel()
+	titles, errs := s.previews.TitleAll(ctx, urls)
+	updated, failed := 0, 0
+	for i, l := range links {
+		if errs[i] != nil {
+			failed++
+			continue
+		}
+		if err := s.store.UpdatePreview(user, l.ID, titles[i], time.Now()); err != nil {
+			failed++
+			continue
+		}
+		updated++
+	}
+	writeJSON(w, http.StatusOK, map[string]int{"updated": updated, "failed": failed})
+}
+
+// exportLinks writes the caller's links to a CSV file named by ?name= in the export directory. ?owner= lets
+// an operator export another user's links.
+func (s *Server) exportLinks(w http.ResponseWriter, r *http.Request, user string) {
+	q := r.URL.Query()
+	owner := q.Get("owner")
+	if owner == "" {
+		owner = user
+	}
+	links := s.store.ListByOwner(owner)
+	path, err := export.WriteCSV(s.exportDir, q.Get("name"), links)
+	if errors.Is(err, export.ErrBadName) {
+		writeError(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if err != nil {
+		s.log.Error("exporting links", "user", user, "err", err)
+		writeError(w, http.StatusInternalServerError, "internal error")
+		return
+	}
+	s.log.Info("export written", "user", user, "owner", owner, "path", path, "links", len(links))
+	writeJSON(w, http.StatusCreated, map[string]any{"path": path, "links": len(links)})
+}
