diff --git a/internal/export/export.go b/internal/export/export.go
new file mode 100644
index 0000000..61328c9
--- /dev/null
+++ b/internal/export/export.go
@@ -0,0 +1,96 @@
+// Package export writes links to CSV files.
+package export
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"linkbox/internal/store"
+)
+
+// filePrefix starts the name of every file Cleanup may remove.
+const filePrefix = "export-"
+
+// ErrBadName reports an export name that does not end in .csv.
+var ErrBadName = errors.New("export name must end in .csv")
+
+var header = []string{"id", "url", "title", "tags", "created_at", "preview_title"}
+
+// WriteCSV writes links to the file name in dir, replacing it if it exists, and returns its path.
+func WriteCSV(dir, name string, links []*store.Link) (string, error) {
+	if !strings.HasSuffix(name, ".csv") {
+		return "", ErrBadName
+	}
+	path := filepath.Join(dir, filePrefix+name)
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o600)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+
+	w := csv.NewWriter(f)
+	_ = w.Write(header)
+	for _, l := range links {
+		_ = w.Write([]string{
+			l.ID,
+			cell(l.URL),
+			cell(l.Title),
+			cell(strings.Join(l.Tags, " ")),
+			l.CreatedAt.Format(time.RFC3339),
+			cell(l.PreviewTitle),
+		})
+	}
+	// csv.Writer keeps the first write error and reports it here, so the writes above need no checks.
+	w.Flush()
+	if err := w.Error(); err != nil {
+		return "", fmt.Errorf("writing %s: %w", path, err)
+	}
+	if err := f.Close(); err != nil {
+		return "", fmt.Errorf("closing %s: %w", path, err)
+	}
+	return path, nil
+}
+
+// Cleanup removes the export files in dir that are older than maxAge and returns how many it removed. A file it
+// cannot remove does not stop it: it carries on and returns the errors together.
+func Cleanup(dir string, maxAge time.Duration, now time.Time) (int, error) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0, err
+	}
+	removed := 0
+	var errs []error
+	for _, e := range entries {
+		if !e.Type().IsRegular() || !strings.HasPrefix(e.Name(), filePrefix) {
+			continue
+		}
+		info, err := e.Info()
+		if err != nil {
+			continue // removed since ReadDir listed it
+		}
+		if now.Sub(info.ModTime()) < maxAge {
+			continue
+		}
+		switch err := os.Remove(filepath.Join(dir, e.Name())); {
+		case err == nil:
+			removed++
+		case !errors.Is(err, os.ErrNotExist): // a file removed since ReadDir listed it is no error
+			errs = append(errs, err)
+		}
+	}
+	return removed, errors.Join(errs...)
+}
+
+// cell keeps a spreadsheet from reading a value as a formula (CSV injection): a value that starts with =, +, -, @,
+// a tab or a carriage return gets a leading single quote.
+func cell(s string) string {
+	if s != "" && strings.ContainsAny(s[:1], "=+-@\t\r") {
+		return "'" + s
+	}
+	return s
+}
